# Server Configuration
PORT=5000
NODE_ENV=development
ATTENDANCE_TIMEZONE=Asia/Kolkata

# MongoDB Atlas - Using local MongoDB or development instance
MONGO_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/rural-employment-hub?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d

# AI Integration - Groq API
GROQ_API_KEY=your_groq_api_key_here

# Email Configuration (Gmail)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here

# Twilio Configuration (Optional)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890

# WhatsApp Configuration (Optional)
WHATSAPP_BUSINESS_PHONE_NUMBER=your_whatsapp_number

# Cloudinary Configuration (Optional)
CLOUDINARY_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
